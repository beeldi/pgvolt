#!/bin/sh

# Electric runs as a single, non-clustered node and never uses Erlang distribution. Left at the
# release default of `sname`, the release would start epmd and a distribution listener bound to
# 0.0.0.0 that nothing ever connects to. Disabling distribution opens no epmd or distribution port.
# A deployment that drives the node through `bin/electric rpc` sets this to `sname` to opt back in.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"

# Adjust Erlang logger and SASL config to get a more or less sane behaviour for opentelemetry.
# Without these options, opentelemetry does not emit any logs when running in a release.
# Without the SASL options, logs would get spammed with PROGRESS REPORT messages.
export ELIXIR_ERL_OPTIONS="-kernel logger_sasl_compatible true -sasl sasl_error_logger false -kernel logger_level info"
