[doc Verify handling of the loss and restoration of database connection]

[include _macros.luxinc]

[global pg_container_name=postgres-disconnection__pg]

###

## Start a new Postgres cluster
[invoke setup_pg]

## Start the sync service.
[invoke setup_electric]

[shell electric]
  ??[notice] Starting replication from postgres

  # Reset the failure pattern because we'll be matching on an error.
  -

[invoke stop_pg]

## Observe the connection error.
[shell electric]
  ??[warning] Database connection in connection_pool mode failed
  ??[warning] Reconnecting in 

## Start the Postgres container back up.
[invoke resume_pg]

[shell electric]
  # Increase the timeout before the next match to give Electric time to reconnect
  [timeout 15]

  # A retry that ran while Postgres was down or still booting has logged an error, and that
  # output may still be unread, so only watch for errors once the lock is held again.
  ??[notice] Lock acquired from postgres
  -$fail_pattern

  ??[notice] Starting replication from postgres

[cleanup]
  [invoke teardown]
